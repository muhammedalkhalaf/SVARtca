\name{tca_systems_form}
\alias{tca_systems_form}
\title{Build Complete Systems Form}
\usage{
tca_systems_form(Phi0, As, h, order = NULL, Psis = NULL)
}
\arguments{
\item{Phi0}{Structural impact matrix (K x K). For Cholesky
identification, use \code{t(chol(Sigma))}.}

\item{As}{List of VAR coefficient matrices (A_1, A_2, ..., A_p).}

\item{h}{Maximum IRF horizon.}

\item{order}{Transmission ordering vector (default: \code{1:K}).}

\item{Psis}{Optional list of reduced-form MA coefficient matrices
(Psi_1, ..., Psi_q), each K x K, for VARMA or DSGE models. See
Details. Default \code{NULL} (no MA component).}
}
\value{
A list with components:
  \describe{
    \item{B}{Systems form B matrix (K*(h+1) x K*(h+1)).}
    \item{Omega}{Systems form Omega matrix (K*(h+1) x K*(h+1)).}
  }
}
\description{
Constructs both B and Omega matrices for the systems form
representation x = Bx + Omega*epsilon, following the methodology of
Wegner, Lieb, Smeekes and Wilms (2025).
}
\details{
\strong{Note on \code{Psis}.} For a pure VAR or SVAR model leave
\code{Psis} at its default (\code{NULL}, treated as an empty list): the
moving-average dynamics are generated by \code{(I - B)^{-1}}. Only
VARMA or DSGE models with a moving-average component pass \code{Psis}.
The matrices in \code{Psis} must be the \emph{reduced-form} MA
coefficient matrices, that is, the coefficients on the lagged
reduced-form errors \code{u_t = Phi0 \%*\% epsilon_t} in
\code{y_t = A_1 y_{t-1} + ... + u_t + Psi_1 u_{t-1} + ...}. If the model
is written with structural MA matrices on the structural shocks,
\code{y_t = ... + Phi0 \%*\% (epsilon_t + Psi^s_1 epsilon_{t-1} + ...)},
convert them first: \code{Psi_j = Phi0 \%*\% Psi^s_j \%*\% solve(Phi0)}.
Passing the structural matrices directly gives wrong impulse responses
at horizons 1 and above, because \code{makeOmega_systems} multiplies
each \code{Psi_j} by \code{Phi0} on the right, so that
\code{Psi_j \%*\% Phi0} is the horizon-j structural MA coefficient.
}
\examples{
# 2-variable VAR(1)
Phi0 <- matrix(c(1, 0.3, 0, 0.95), 2, 2)
As <- list(matrix(c(0.5, -0.1, 0.2, 0.4), 2, 2))
sf <- tca_systems_form(Phi0, As, h = 10)
dim(sf$B)  # 22 x 22
}
\references{
Wegner, E., Lieb, L., Smeekes, S. and Wilms, I. (2025).
\emph{Transmission Channel Analysis in Dynamic Models.}
arXiv:2405.18987, \doi{10.48550/arXiv.2405.18987}.
\url{https://github.com/enweg/tca-matlab-toolbox}
}
